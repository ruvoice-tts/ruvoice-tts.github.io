---
import { getSite } from '../lib/site';
import PackCard from './PackCard.astro';

const { packs } = await getSite();
---
<section class="wrap sec" aria-labelledby="packs-title">
  <p class="eyebrow" data-thread="pin">Паки</p>
  <h2 class="sec-title" id="packs-title">Паки голосов</h2>
  <p class="intro">Дополнительные голоса ставятся из файла прямо в приложении.</p>
  <div class="grid">{packs.slice(0, 4).map(p => <PackCard p={p} compact />)}</div>
  <a class="more" href="/packs/" id="packs-more">Все паки и как их поставить</a>
</section>

<script>
  import { initPlayButtons } from '../scripts/play-buttons';
  initPlayButtons(document.getElementById('packs-title')!.closest('section')!);
</script>

<style>
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); margin-top: 8px; }
  .more {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 48px; font-weight: 650; font-size: 1.0625rem;
    text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
</style>
