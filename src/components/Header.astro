---
import Logo from './Logo.astro';

interface Props { home: boolean }
const { home } = Astro.props;
const at = (id: string) => (home ? `#${id}` : `/#${id}`);
const links: Array<[string, string, string]> = [
  ['nav-voices', 'Голоса', at('voices')],
  ['nav-reads', 'Как читается', at('reads')],
  ['nav-install', 'Установка', at('install')],
  ['nav-packs', 'Паки', '/packs/'],
  ['nav-faq', 'Вопросы', at('faq')],
];
---
<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" id="logo-link"><Logo uid="head" class="logo-mark" thread={home} /><span>RuVoice</span></a>
    <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
      <span class="vh">Меню</span>
    </button>
    <nav class="nav" id="nav" aria-label="Разделы">
      {links.map(([id, text, href]) => <a href={href} id={id}>{text}</a>)}
    </nav>
    <button class="icon-btn" id="theme-btn" type="button" aria-pressed="false">
      <svg class="theme-light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
      <svg class="theme-dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="vh">Тёмная тема</span>
    </button>
    <a class="pill header-dl" href={at('download')} id="header-download">Скачать</a>
  </div>
</header>

<script>
  import { initHeader } from '../scripts/menu';
  initHeader();
</script>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.15); backdrop-filter: blur(14px) saturate(1.15);
    border-bottom: 1px solid transparent; transition: border-color .25s;
  }
  .site-header.is-stuck { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; gap: 12px; min-height: 72px; flex-wrap: wrap; }
  .logo {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none;
    font-weight: 650; font-size: 1.25rem; letter-spacing: -.01em; border-radius: 12px; min-height: 48px;
  }
  .logo :global(.logo-mark) { width: 38px; height: 38px; display: block; flex: none; filter: drop-shadow(0 6px 12px rgba(26, 35, 126, .28)); }
  .nav { display: flex; gap: 4px; margin-left: auto; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 48px;
    text-decoration: none; color: var(--ink-2); font-weight: 500; padding: 0 12px; border-radius: 10px;
    background-image: linear-gradient(var(--amber), var(--amber)); background-repeat: no-repeat;
    background-size: 0 2px; background-position: 12px calc(100% - 8px); transition: color .2s, background-size .25s;
  }
  .nav a:hover { color: var(--ink); background-size: calc(100% - 24px) 2px; }
  .icon-btn {
    width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--outline); background: transparent; color: var(--ink);
    display: inline-grid; place-items: center; cursor: pointer; flex: none;
  }
  .icon-btn svg { width: 22px; height: 22px; }
  .theme-dark-icon { display: none; }
  :global(.is-dark) .theme-dark-icon { display: block; }
  :global(.is-dark) .theme-light-icon { display: none; }
  .pill {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px;
    border-radius: 999px; background: var(--indigo); color: var(--on-indigo); font-weight: 650; text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .25), 0 10px 22px -12px var(--shadow);
    transition: transform .18s cubic-bezier(.34, 1.56, .64, 1), background-color .2s;
  }
  .pill:hover { background: var(--indigo-2); }
  .pill:active { transform: scale(.97); }
  .menu-btn { display: none; }

  @media (max-width: 900px) {
    /* без JS ссылки идут строкой под логотипом, кнопка меню не нужна */
    .nav { order: 10; width: 100%; flex-wrap: wrap; margin-left: 0; }
    .header-dl { margin-left: auto; }
    :global(.js) .menu-btn { display: inline-grid; margin-left: auto; }
    :global(.js) .header-dl { margin-left: 0; }
    :global(.js) .nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; gap: 0;
      padding: 8px max(16px, env(safe-area-inset-right, 0px)) 16px max(16px, env(safe-area-inset-left, 0px));
      background: var(--card); border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px -24px var(--shadow);
    }
    :global(.js) .nav.is-open { display: flex; }
    :global(.js) .nav a { font-size: 1.125rem; }
  }
  @media (max-width: 479px) { :global(.js) .header-dl { display: none; } }
  @media (prefers-reduced-motion: reduce) { .pill, .nav a, .site-header { transition: none; } }
</style>
