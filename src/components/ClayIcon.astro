---
// Мягкие объёмные значки: градиентная плитка со светом сверху слева и белый знак. Декор, скрыт от чтецов.
interface Props { name: 'dict' | 'parse' | 'names' | 'move' }
const { name } = Astro.props;
const id = `clay-${name}`;
const glyph = {
  dict: 'M19 15h14a3 3 0 0 1 3 3v19H22a3 3 0 0 0-3 3V15Zm0 25a3 3 0 0 0 3 3h14M25 22h6M25 28h4',
  parse: 'M27 18a9 9 0 1 1 0 18 9 9 0 0 1 0-18Zm6.5 15.5L39 39M23 27h8',
  names: 'M28 26a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm-9 12c1-5.5 4.6-8 9-8s8 2.5 9 8',
  move: 'M17 22h18l-4-4M39 34H21l4 4',
}[name];
---
<svg class="clay" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="6" y1="4" x2="50" y2="52" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#8E96F2" /><stop offset=".55" stop-color="#4A54C9" /><stop offset="1" stop-color="#2A3192" />
    </linearGradient>
    <radialGradient id={`${id}-hi`} cx="16" cy="12" r="26" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect x="4" y="4" width="48" height="48" rx="16" fill={`url(#${id})`} />
  <rect x="4" y="4" width="48" height="48" rx="16" fill={`url(#${id}-hi)`} />
  <path d={glyph} fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="44" cy="12" r="3" fill="#FFC107" />
</svg>

<style>
  .clay { width: 56px; height: 56px; flex: none; filter: drop-shadow(0 10px 14px rgba(42, 49, 146, .28)); }
</style>
