---
import { getSite } from '../lib/site';

const { release, packs } = await getSite();
const langs = new Set(packs.map(p => p.lang));
const data = {
  version: release.app.version, full: release.app.full, lite: release.app.lite,
  rustore: 'https://www.rustore.ru/catalog/app/ru.kost.ruvoice',
  packs: packs.map(p => ({ id: p.id, lang: p.lang, title: p.title, url: p.url, size: p.size })),
};
---
<div class="wizard" id="wizard">
  <h3 class="w-title" id="wizard-title">Не знаете, что скачать? <em>Подберём</em> за три вопроса</h3>
  <form id="wizard-form" aria-labelledby="wizard-title" hidden>
    <fieldset>
      <legend>Как удобнее ставить?</legend>
      <label class="opt"><input type="radio" name="source" value="rustore" /><span>Из RuStore: обновления приходят сами, обычно на неделю позже</span></label>
      <label class="opt"><input type="radio" name="source" value="file" checked /><span>Файлом с этого сайта</span></label>
    </fieldset>
    <fieldset>
      <legend>Какие голоса нужны?</legend>
      <label class="opt"><input type="checkbox" name="langs" value="ru" checked /><span>Русские</span></label>
      {langs.has('be') && <label class="opt"><input type="checkbox" name="langs" value="be" /><span>Белорусские</span></label>}
      {langs.has('uk') && <label class="opt"><input type="checkbox" name="langs" value="uk" /><span>Украинские</span></label>}
    </fieldset>
    <fieldset>
      <legend>Важно, сколько весят обновления?</legend>
      <label class="opt"><input type="radio" name="updates" value="small" /><span>Да, хочу обновления полегче</span></label>
      <label class="opt"><input type="radio" name="updates" value="any" checked /><span>Нет, главное, чтобы работало сразу</span></label>
    </fieldset>
    <div class="nav">
      <button type="button" class="w-btn ghost" id="wizard-back">Назад</button>
      <button type="button" class="w-btn" id="wizard-next">Дальше</button>
      <button type="submit" class="w-btn" id="wizard-go">Подобрать</button>
    </div>
  </form>
  <noscript><p class="w-nojs">Подбор работает с JavaScript. Обе сборки есть в начале страницы, все паки — на странице паков.</p></noscript>
  <div class="result" id="wizard-result" hidden>
    <h4 id="wizard-result-title" tabindex="-1"></h4>
    <ul id="wizard-result-list"></ul>
    <p id="wizard-result-note"></p>
  </div>
</div>
<script type="application/json" id="wizard-data" is:inline set:html={JSON.stringify(data)}></script>

<script>
  import { initWizard } from '../scripts/wizard-ui';
  initWizard();
</script>

<style>
  .wizard {
    position: relative; margin-top: 28px; padding: 32px; border-radius: 30px;
    background: var(--bg-2); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 20px;
  }
  .w-title { margin: 0; font-family: var(--font-display); font-weight: 560; font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); line-height: 1.12; letter-spacing: -.015em; }
  .w-title em { font-style: italic; font-weight: 480; color: var(--accent-word); }
  form { display: flex; flex-direction: column; gap: 18px; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; }
  legend { font-weight: 650; font-size: 1.25rem; margin-bottom: 6px; }
  .opt { display: flex; align-items: center; gap: 14px; min-height: 56px; padding: 0 18px; border-radius: 18px; border: 1px solid var(--outline); background: var(--card); cursor: pointer; }
  .opt input { width: 22px; height: 22px; accent-color: var(--indigo); flex: none; }
  .opt:has(input:checked) { border-color: var(--indigo); box-shadow: 0 0 0 2px var(--indigo) inset; }
  .nav { display: flex; gap: 12px; flex-wrap: wrap; }
  .w-btn { min-height: 52px; padding: 0 26px; border-radius: 999px; border: 0; background: var(--indigo); color: var(--on-indigo); font: inherit; font-weight: 650; cursor: pointer; }
  .w-btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--outline); }
  .result { display: flex; flex-direction: column; gap: 12px; padding-top: 8px; border-top: 1px solid var(--line); }
  .result h4 { margin: 8px 0 0; font-family: var(--font-display); font-size: 1.75rem; font-weight: 560; }
  .result ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .result :global(.result-link) { padding: 0 22px; }
  .result p { margin: 0; color: var(--ink-2); }
  .w-nojs { margin: 0; color: var(--ink-2); }
  @media (max-width: 520px) { .wizard { padding: 22px; } }
</style>
