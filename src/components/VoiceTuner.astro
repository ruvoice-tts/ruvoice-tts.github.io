---
import packsMeta from '../data/packs.json';
import phrases from '../data/phrases.json';
import samples from '../data/samples.json';
import voices from '../data/voices.json';
import { pluralRu } from '../lib/format';
import { getSite } from '../lib/site';
import VoiceCard from './VoiceCard.astro';

const { release } = await getSite();
const list = voices.filter(v => v.inTuner && (v.builtIn || v.pack in release.packs));
const builtIn = voices.filter(v => v.builtIn).length;
const langs = [...new Set(list.map(v => v.lang))];
const extra = [langs.includes('be') && 'белорусскими', langs.includes('uk') && 'украинскими'].filter(Boolean).join(' и ');
const intro = `Одна и та же фраза разными голосами. ${builtIn} ${pluralRu(builtIn, 'голос', 'голоса', 'голосов')} в полной сборке и паки с ${extra || 'дополнительными'} голосами.`;
const filters: Array<[string, string]> = [['all', 'Все'], ['builtin', 'Встроенные'], ['packs', 'Паки'],
  ...(langs.includes('be') ? [['be', 'Белорусские'] as [string, string]] : []), ...(langs.includes('uk') ? [['uk', 'Украинские'] as [string, string]] : [])];
const phraseKeys = Object.keys(phrases.voice) as Array<keyof typeof phrases.voice>;
const title = (pack: string) => packsMeta.find(p => p.id === pack)?.title;
const S = samples as Record<string, { file: string; env: number[] }>;
// громкость по 50 мс одной цифрой: максимум двух соседних значений по 25 мс
const env = (e: number[]) => Array.from({ length: Math.ceil(e.length / 2) }, (_, i) => Math.round(Math.max(e[2 * i], e[2 * i + 1] ?? 0) * 9)).join('');
const data = Object.fromEntries(list.map(v => [v.key, Object.fromEntries(Object.entries(v.samples).map(([p, k]) =>
  [p, { src: `${import.meta.env.BASE_URL}${S[k].file}`, env: env(S[k].env) }]))]));
---
<section class="wrap tuner-section" id="voices" aria-labelledby="voices-title">
  <p class="eyebrow" data-thread="pin">Голоса</p>
  <h2 id="voices-title">Подберите <em>свой</em> голос</h2>
  <p class="intro">{intro}</p>
  <div class="controls">
    <fieldset>
      <legend class="vh">Какие голоса показать</legend>
      {filters.map(([value, text], i) => (
        <label class="chip"><input type="radio" name="vfilter" value={value} checked={i === 0} /><span>{text}</span></label>
      ))}
    </fieldset>
    <fieldset class="seg">
      <legend class="vh">Что прочитать</legend>
      {phraseKeys.map((p, i) => (
        <label class="chip"><input type="radio" name="vphrase" value={p} checked={i === 0} /><span>{phrases.voice[p].label}</span></label>
      ))}
    </fieldset>
  </div>
  <div class="tuner">
    <div class="needle" aria-hidden="true" data-thread="needle" data-thread-side="left"></div>
    <ul class="voice-list">
      {list.map(v => <VoiceCard v={v} packTitle={title(v.pack)} />)}
    </ul>
  </div>
  <button type="button" class="all" id="tuner-all">Слушать подряд</button>
</section>
<script type="application/json" id="tuner-data" is:inline set:html={JSON.stringify(data)}></script>

<script>
  import { initTuner } from '../scripts/tuner';
  initTuner();
</script>

<style>
  .tuner-section { padding-block: 88px 72px; display: flex; flex-direction: column; gap: 18px; }
  .eyebrow {
    margin: 0; display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    font-size: .8125rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2);
  }
  .eyebrow::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 4px var(--amber-glow); }
  h2 { margin: 0; font-family: var(--font-display); font-weight: 560; font-size: clamp(2.2rem, 1.4rem + 3vw, 4rem); line-height: 1.04; letter-spacing: -.025em; text-wrap: balance; }
  h2 em { font-style: italic; font-weight: 480; color: var(--accent-word); }
  .intro { margin: 0; max-width: 36em; color: var(--ink-2); font-size: 1.125rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 8px; }
  fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; display: inline-flex; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 18px; border-radius: 999px;
    border: 1px solid var(--outline); color: var(--ink); font-weight: 550; background: transparent;
  }
  .chip input:checked + span { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 3px solid var(--ink); outline-offset: 3px; box-shadow: 0 0 0 6px var(--amber-glow); }
  .seg .chip input:checked + span { background: var(--indigo); color: var(--on-indigo); border-color: var(--indigo); }
  .tuner { position: relative; margin-inline: calc(-1 * max(16px, env(safe-area-inset-left, 0px))); }
  .needle {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-1px);
    pointer-events: none;
  }
  .voice-list {
    list-style: none; margin: 0; display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 24px calc(50% - min(130px, 37vw)); scrollbar-width: thin; position: relative; z-index: 2;
  }
  .all {
    align-self: flex-start; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 1px solid var(--outline);
    background: var(--card); color: var(--ink); font: inherit; font-weight: 650; cursor: pointer;
  }
  .all:hover { background: var(--bg-2); }
  @media (min-width: 720px) {
    .tuner { margin-inline: calc(-1 * max(40px, env(safe-area-inset-left, 0px))); }
    /* на широком экране лента начинается от края колонки; к центру со стрелкой карточки прилипают при прокрутке */
    .voice-list { padding-inline: max(40px, env(safe-area-inset-left, 0px)); }
  }
  @media (prefers-reduced-motion: reduce) { .voice-list { scroll-behavior: auto; } }
</style>
