---
const steps: Array<[string, string]> = [
  ['Скачайте', 'APK с этого сайта или RuStore. Android может спросить разрешение на установку из браузера, его нужно дать.'],
  ['Включите', 'Настройки Android → Синтез речи (или «Преобразование текста в речь») → выберите RuVoice. В приложении есть подсказка: меню ⋮ → «Как включить».'],
  ['Слушайте', 'Откройте книгу в читалке и включите чтение вслух.'],
];
---
<section class="wrap sec install" id="install" aria-labelledby="install-title">
  <p class="eyebrow" data-thread="pin">Установка</p>
  <h2 class="sec-title" id="install-title">Три шага до <em>первой</em> книги</h2>
  <ol class="steps">
    {steps.map(([title, text], i) => (
      <li style={`--i: ${i}`}>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <div><h3>{title}</h3><p>{text}</p></div>
      </li>
    ))}
  </ol>
  <slot />
</section>

<style>
  .steps { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 20px; }
  .steps li {
    position: sticky; top: calc(96px + var(--i) * 22px);
    display: flex; gap: 28px; align-items: flex-start; padding: 32px; min-height: 180px;
    background: var(--card); border: 1px solid var(--line); border-radius: 30px;
    box-shadow: inset 0 1px 0 var(--hi), 0 -12px 40px -24px var(--shadow), 0 30px 60px -40px var(--shadow);
  }
  .num { font-family: var(--font-display); font-weight: 560; font-size: clamp(3.5rem, 2rem + 4vw, 5.5rem); line-height: .9; color: var(--accent-word); flex: none; min-width: 1ch; }
  h3 { margin: 8px 0 8px; font-family: var(--font-display); font-weight: 560; font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); letter-spacing: -.015em; }
  .steps p { margin: 0; color: var(--ink-2); font-size: 1.125rem; max-width: 40em; }
  @media (max-width: 520px) { .steps li { padding: 24px; gap: 18px; } }
</style>
