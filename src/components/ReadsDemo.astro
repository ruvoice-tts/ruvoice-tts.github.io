---
import phrases from '../data/phrases.json';
import samples from '../data/samples.json';

const S = samples as Record<string, { file: string; duration: number; raw?: string; display?: string }>;
const base = import.meta.env.BASE_URL;
// точку в конце ставит конвейер (конец фразы для модели); в подписи под примером она лишняя
const reads = phrases.reads.map(r => { const x = S[`reads/${r.id}`]; return { key: `reads/${r.id}`, ...x, display: x.display!.replace(/\.$/, '') }; });
const data = Object.fromEntries(reads.map(r => [r.key, { src: `${base}${r.file}`, raw: r.raw, display: r.display, duration: r.duration }]));
const first = reads[0];
---
<section class="wrap sec reads" id="reads" aria-labelledby="reads-title">
  <p class="eyebrow">Как читается</p>
  <h2 class="sec-title" id="reads-title">Цифры, даты и сокращения <em>по-русски</em></h2>
  <p class="intro">Нажмите на пример и послушайте. Движок сам склоняет числа и ставит ударения по смыслу.</p>
  <div class="grid">
    <div class="chips" role="group" aria-label="Примеры">
      {reads.map(r => (
        <button type="button" class="chip-read" data-key={r.key} aria-pressed="false">
          <span class="raw">{r.raw}</span>
        </button>
      ))}
    </div>
    <div class="out" aria-hidden="true">
      <p class="out-raw" id="reads-out-raw">{first.raw}</p>
      <p class="out-said" id="reads-out-said">{first.display}</p>
    </div>
  </div>
  <p class="vh" id="reads-live" aria-live="polite"></p>
  <div class="homo">
    <p class="homo-text">Король жил в з<mark>а́</mark>мке, а на двери висел зам<mark>о́</mark>к.</p>
    <p class="homo-cap">Омографы по контексту: за́мок и замо́к</p>
    <button type="button" class="homo-play" id="homo-play" aria-pressed="false" data-play={`${base}${S.homograph.file}`}>
      <span class="i" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.6-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg></span>
      <span class="label">Послушать</span><span class="vh">: король жил в за́мке, а на двери висел замо́к</span>
    </button>
  </div>
</section>
<script type="application/json" id="reads-data" is:inline set:html={JSON.stringify(data)}></script>

<script>
  import { initReads } from '../scripts/reads';
  initReads();
</script>

<style>
  .grid { display: grid; gap: 24px 48px; grid-template-columns: minmax(0, 1fr); margin-top: 12px; align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); } }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip-read {
    min-height: 56px; padding: 0 22px; border-radius: 18px; cursor: pointer;
    border: 1px solid var(--outline); background: var(--card); color: var(--ink);
    font: inherit; font-size: 1.125rem; font-weight: 600; font-variant-numeric: tabular-nums;
    box-shadow: inset 0 1px 0 var(--hi), 0 10px 22px -16px var(--shadow);
    transition: transform .18s cubic-bezier(.34, 1.56, .64, 1), background-color .2s, border-color .2s;
  }
  .chip-read:hover { border-color: var(--ink); }
  .chip-read:active { transform: scale(.97); }
  .chip-read[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .out {
    min-height: 220px; display: flex; flex-direction: column; justify-content: center; gap: 12px;
    padding: 32px; border-radius: 30px; background: var(--card); border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 var(--hi), 0 30px 60px -36px var(--shadow);
  }
  .out-raw { margin: 0; color: var(--ink-3); font-size: 1.125rem; font-variant-numeric: tabular-nums; }
  .out-raw::after { content: " →"; color: var(--amber); }
  .out-said {
    margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.6rem); line-height: 1.15;
    letter-spacing: -.015em; text-decoration: underline; text-decoration-color: var(--amber);
    text-decoration-thickness: 3px; text-underline-offset: 10px;
  }
  .out-said :global(.rest) { color: var(--line); text-decoration-color: transparent; }
  .homo {
    display: grid; gap: 10px 24px; grid-template-columns: minmax(0, 1fr); align-items: center; margin-top: 24px;
    padding: 28px; border-radius: 30px; background: var(--bg-2); border: 1px solid var(--line);
  }
  @media (min-width: 720px) { .homo { grid-template-columns: minmax(0, 1fr) auto; } .homo-cap { grid-row: 2; } }
  .homo-text { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 1rem + 1.4vw, 2rem); line-height: 1.25; }
  .homo-text mark { background: var(--hl); color: var(--ink); border-radius: .15em; padding: 0 .05em; }
  .homo-cap { margin: 0; color: var(--ink-2); }
  .homo-play {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px 0 6px; justify-self: start;
    border-radius: 999px; border: 1px solid var(--outline); background: var(--card); color: var(--ink);
    font: inherit; font-weight: 650; cursor: pointer;
  }
  @media (min-width: 720px) { .homo-play { grid-row: 1 / span 2; grid-column: 2; } }
  .homo-play .i { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--indigo); color: var(--on-indigo); }
  .homo-play svg { width: 16px; height: 16px; }
  .homo-play[aria-pressed="true"] { border-color: var(--amber); box-shadow: 0 0 0 3px var(--amber-glow); }
  @media (prefers-reduced-motion: reduce) { .chip-read { transition: none; } }
</style>
