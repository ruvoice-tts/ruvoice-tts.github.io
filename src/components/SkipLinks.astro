---
// Первые три фокусируемых элемента страницы: чтецу до скачивания полной сборки — свайп и двойное касание,
// до паков голосов — три свайпа, без пролистывания всей страницы.
import type { Asset } from '../lib/github';
import { formatMB } from '../lib/format';

interface Props { full: Asset; version: string; path: string }
const { full, version, path } = Astro.props;
const home = path === '/';
const packs = home ? '#packs' : path === '/packs/' ? '#pack-list' : '/packs/';
---
<div class="skips">
  <a class="skip" id="skip-full" href={full.url}>Скачать полную сборку {version}, APK, {formatMB(full.size)}</a>
  <a class="skip" id="skip-card" href={home ? '#download' : '/#download'}>Другие варианты скачивания</a>
  <a class="skip" id="skip-packs" href={packs}>Скачать паки голосов</a>
</div>

<style>
  .skip {
    position: fixed; z-index: 50;
    left: max(16px, env(safe-area-inset-left, 0px)); top: calc(env(safe-area-inset-top, 0px) + 12px);
    transform: translateY(-200%);
    background: var(--indigo); color: var(--on-indigo); font-weight: 650; text-decoration: none;
    padding: 14px 22px; border-radius: 999px; max-width: calc(100vw - 32px);
  }
  .skip:focus-visible { transform: none; }
</style>
