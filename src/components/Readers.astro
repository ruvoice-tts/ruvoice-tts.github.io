---
import voice from '../assets/screens/voice.png';
import PhoneFrame from './PhoneFrame.astro';

const readers = ['AlReaderX', 'Moon+ Reader', 'Cool Reader', 'FBReader', 'Librera', 'KOReader', 'и любая другая'];
---
<section class="wrap sec readers" aria-labelledby="readers-title">
  <div class="cols">
    <div class="text">
      <p class="eyebrow" data-thread="pin">Читалки</p>
      <h2 class="sec-title" id="readers-title">Работает там, где вы <em>уже</em> читаете</h2>
      <p class="intro">RuVoice ставится как обычный голос Android, поэтому его видит любая читалка с функцией «Читать вслух».</p>
      <ul class="row">{readers.map(r => <li>{r}</li>)}</ul>
      <p class="hint">Подсветка читаемого слова, если читалка это умеет.</p>
    </div>
    <PhoneFrame src={voice} alt="Вкладка «Голос» в приложении: выбор голоса, частота, темп и высота" />
  </div>
</section>

<style>
  .cols { display: grid; gap: 40px 64px; grid-template-columns: minmax(0, 1fr); align-items: center; justify-items: center; }
  @media (min-width: 960px) { .cols { grid-template-columns: minmax(0, 1fr) auto; justify-items: stretch; } }
  .text { display: flex; flex-direction: column; gap: 18px; min-width: 0; width: 100%; }
  /* просто список: бегущую строку не остановить ни пальцем, ни клавиатурой (WCAG 2.2.2) */
  .row { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .row li {
    display: inline-flex; align-items: center; min-height: 52px; padding: 0 22px; border-radius: 999px; white-space: nowrap;
    background: var(--card); border: 1px solid var(--line); font-weight: 600; font-size: 1.0625rem;
  }
  .row li:last-child { color: var(--ink-2); font-style: italic; }
  .hint { margin: 0; color: var(--ink-2); }
</style>
