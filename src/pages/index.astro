---
import Aurora from '../components/Aurora.astro';
import Hero from '../components/Hero.astro';
import InstallSteps from '../components/InstallSteps.astro';
import Pronunciation from '../components/Pronunciation.astro';
import Readers from '../components/Readers.astro';
import ScreenReaderBand from '../components/ScreenReaderBand.astro';
import Values from '../components/Values.astro';
import ReadsDemo from '../components/ReadsDemo.astro';
import Thread from '../components/Thread.astro';
import VoiceTuner from '../components/VoiceTuner.astro';
import Base from '../layouts/Base.astro';
---
<Base title="RuVoice — живой голос для любой читалки" description="Офлайн-голос Android для книг и экранного чтеца: нейросеть Silero прямо на телефоне, ударения по смыслу, числа и даты по-русски." path="/">
  <Aurora />
  <Thread />
  <main>
    <Hero />
    <VoiceTuner />
    <ReadsDemo />
    <Readers />
    <Pronunciation />
    <Values />
    <ScreenReaderBand />
    <InstallSteps />
  </main>
</Base>
