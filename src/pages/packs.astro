---
import PackCard from '../components/PackCard.astro';
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site';

const { packs } = await getSite();
---
<Base title="Паки голосов — RuVoice" description="Дополнительные голоса RuVoice: русские, белорусские и украинские паки, размеры, образцы и прямые ссылки на скачивание." path="/packs/">
  <main class="wrap sec packs-page">
    <h1 class="sec-title">Паки голосов</h1>
    <p class="intro">Пак — это zip-файл с голосами. Распаковывать не нужно: в приложении меню ⋮ → «Дополнительные голоса…» → «Установить из файла…», выберите файл. Голоса появятся на вкладке «Голос» и в списке голосов читалки.</p>
    <div class="list">{packs.map(p => <PackCard p={p} />)}</div>
  </main>
</Base>

<script>
  import { initPlayButtons } from '../scripts/play-buttons';
  initPlayButtons();
</script>

<style>
  .packs-page { padding-block: 56px 96px; }
  .list { display: grid; gap: 20px; margin-top: 16px; }
</style>
